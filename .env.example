# Avantdex configuration. Copy to .env for local `docker compose` runs; in Coolify set these in the UI.
# Public values below are real Arc Testnet facts. Secrets have NO default and must be set by you.

# ---- network (Arc Testnet, chain id 5042002) ----
CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.io
EXPLORER_URL=https://explorer.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- platform fees: 0.5% buyer + 0.5% seller on successful trades, paid in USDC to this address ----
# Used by scripts/deploy-testnet.sh when the contract is deployed. After deployment the contract holds the
# address; change it later from Admin -> Settings (on-chain transaction by the contract's admin wallet).
FEE_COLLECTOR=0x136a2C17E0E6C077F48F489BeC6DBCE3202CEbd6

# ---- fill these in after deploying the exchange (scripts/deploy-testnet.sh prints them) ----
EXCHANGE_ADDRESS=
EXCHANGE_DEPLOY_BLOCK=

# ---- PostgreSQL (bundled container; for an external DB set DATABASE_URL instead) ----
POSTGRES_USER=avantdex
POSTGRES_DB=avantdex
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---- secrets: generate your own ----
#   JWT_SECRET:        openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 24
JWT_SECRET=
POSTGRES_PASSWORD=

# ---- admin / site ----
# Admin wallet(s) (comma separated). There is ONE admin level: every admin can review, approve, list and manage markets.
BOOTSTRAP_ADMIN_ADDRESSES=
# Your public domain (only shown inside the wallet sign-in message)
AUTH_DOMAIN=your-domain.example.com
AUTH_URI=https://your-domain.example.com
# More admin wallets as wallet:role entries (any role name means admin; use super_admin). Removing an entry removes
# the admin at the next start (admins added in the dashboard are never touched; the last admin is always kept).
# Note: creating/activating a market also needs the on-chain MARKET_MANAGER role on that wallet (Admin -> Admins).
ADMIN_ROLES=
REQUIRE_TWO_PERSON_APPROVAL=false
# Optional https URL (Slack, Discord or any relay that accepts JSON with a "text" field). It receives a message when
# something needs attention: a TGE date passed, a settlement deadline within 24h, a stopped indexer.
ADMIN_WEBHOOK_URL=
# How often (seconds) the indexer checks deadlines, writes reminders and sends the webhook
OPS_INTERVAL_SECONDS=60

# ---- Circle Wallet: passkey sign-in with a smart account (optional; empty = the option shows "not set up yet") ----
# 1. Circle Console -> Keys -> Client Keys: create a Client Key. It is meant for browsers (it is public) and starts with
#    TEST_API_KEY: for testnets (a LIVE_API_KEY: key cannot be used on Arc Testnet).
# 2. Circle Console -> Modular Wallets -> Passkey Domain: register your site's domain exactly as users see it
#    (for example avantdex.xyz). Passkeys are tied to that domain and do not work on any other one.
# 3. Optional: Console -> Gas Station: a paymaster policy lets Circle pay users' network fees.
# The API hands the key to the page through /api/config, so changing it needs no rebuild.
CIRCLE_CLIENT_KEY=
CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
# Ask Gas Station to sponsor each transaction first (it falls back to the wallet's own USDC when it cannot)
CIRCLE_PAYMASTER=true

# ---- keeper (optional chores worker; idles unless enabled) ----
# Expires old orders and refunds trades of cancelled or abandoned markets for everyone. Use a NEW small wallet that
# holds only a little USDC for gas (Arc's gas token). It needs no role. Never reuse an admin or deployer key.
KEEPER_ENABLED=false
KEEPER_PRIVATE_KEY=
# Log what it would send without sending (good for the first day)
KEEPER_DRY_RUN=false
# Also call completeMarket when every trade is closed. Needs MARKET_MANAGER on the keeper wallet: leave off unless you accept a hot key with that role.
KEEPER_COMPLETE_MARKETS=false
KEEPER_MAX_GAS_GWEI=25

# ---- frontend (build time, only for `bun run build:static`; both optional) ----
# VITE_RPC_URL=https://rpc.testnet.arc.io
